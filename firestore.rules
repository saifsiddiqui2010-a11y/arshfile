rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: default-deny all unspecified paths
    match /{document=**} {
      allow read, write: if false;
    }

    // -----------------------------------------------------------------------
    // Global Hardened Primitives
    // -----------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidShareId(id) {
      return id is string && id.size() >= 6 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // -----------------------------------------------------------------------
    // Validation Blueprint: UserProfile (/users/{userId})
    // -----------------------------------------------------------------------
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && data.uid == request.auth.uid
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() <= 120
        && data.photoURL is string && data.photoURL.size() <= 1024
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // -----------------------------------------------------------------------
    // Validation Blueprint: Folder (/folders/{folderId})
    // -----------------------------------------------------------------------
    function isValidFolder(data, folderId) {
      return data.keys().hasAll(['folderId', 'ownerId', 'name', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['folderId', 'ownerId', 'name', 'createdAt', 'updatedAt'])
        && data.folderId is string && data.folderId == folderId && isValidId(data.folderId)
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // -----------------------------------------------------------------------
    // Validation Blueprint: UploadedFile (/files/{shareId})
    // -----------------------------------------------------------------------
    function isValidUploadedFile(data, shareId) {
      return data.keys().hasAll([
          'shareId', 'ownerId', 'ownerDisplayName', 'fileName', 'originalName',
          'mimeType', 'category', 'extension', 'sizeBytes', 'sha256',
          'visibility', 'folderId', 'description',
          'directPath', 'downloadPath', 'sharePath', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'shareId', 'ownerId', 'ownerDisplayName', 'fileName', 'originalName',
          'mimeType', 'category', 'extension', 'sizeBytes', 'sha256',
          'visibility', 'folderId', 'description',
          'directPath', 'downloadPath', 'sharePath', 'createdAt', 'updatedAt'
        ])
        && data.shareId is string && data.shareId == shareId && isValidShareId(data.shareId)
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.ownerDisplayName is string && data.ownerDisplayName.size() <= 120
        && data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 255
        && data.originalName is string && data.originalName.size() >= 1 && data.originalName.size() <= 255
        && data.mimeType is string && data.mimeType.size() >= 1 && data.mimeType.size() <= 128
        && data.category is string && data.category in ['image', 'video', 'audio', 'document', 'archive', 'other']
        && data.extension is string && data.extension.size() <= 24
        && data.sizeBytes is int && data.sizeBytes >= 0 && data.sizeBytes <= 262144000
        && data.sha256 is string && data.sha256.size() == 64 && data.sha256.matches('^[a-f0-9]{64}$')
        && data.visibility is string && data.visibility in ['public', 'unlisted', 'private']
        && data.folderId is string && data.folderId.size() <= 128
        && (data.folderId == '' || isValidId(data.folderId))
        && data.description is string && data.description.size() <= 500
        && data.directPath is string && data.directPath.size() <= 256 && data.directPath == ('/api/raw/' + shareId)
        && data.downloadPath is string && data.downloadPath.size() <= 256 && data.downloadPath == ('/api/download/' + shareId)
        && data.sharePath is string && data.sharePath.size() <= 256 && data.sharePath == ('/s/' + shareId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function ownsFolderIfSet(folderId) {
      return folderId == ''
        || (
          exists(/databases/$(database)/documents/folders/$(folderId))
          && get(/databases/$(database)/documents/folders/$(folderId)).data.ownerId == request.auth.uid
        );
    }

    function isImmutableFileUnchanged() {
      return incoming().shareId == existing().shareId
        && incoming().ownerId == existing().ownerId
        && incoming().ownerDisplayName == existing().ownerDisplayName
        && incoming().originalName == existing().originalName
        && incoming().mimeType == existing().mimeType
        && incoming().category == existing().category
        && incoming().extension == existing().extension
        && incoming().sizeBytes == existing().sizeBytes
        && incoming().sha256 == existing().sha256
        && incoming().directPath == existing().directPath
        && incoming().downloadPath == existing().downloadPath
        && incoming().sharePath == existing().sharePath
        && incoming().createdAt == existing().createdAt;
    }

    // -----------------------------------------------------------------------
    // Collection: /users/{userId} (PII Isolated — strictly owner-only)
    // -----------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'photoURL', 'updatedAt']);
      allow delete: if isVerifiedUser() && isValidId(userId) && request.auth.uid == userId;
    }

    // -----------------------------------------------------------------------
    // Collection: /folders/{folderId} (Strictly owner-only)
    // -----------------------------------------------------------------------
    match /folders/{folderId} {
      allow get: if isSignedIn() && isValidId(folderId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(folderId)
        && isValidFolder(incoming(), folderId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(folderId)
        && isValidFolder(incoming(), folderId)
        && existing().ownerId == request.auth.uid
        && incoming().folderId == existing().folderId
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt']);
      allow delete: if isVerifiedUser() && isValidId(folderId) && existing().ownerId == request.auth.uid;
    }

    // -----------------------------------------------------------------------
    // Collection: /files/{shareId} (Owner CRUD + Public/Unlisted Single Get)
    // -----------------------------------------------------------------------
    match /files/{shareId} {
      // Single-document get: Owner can always read; anyone with the exact shareId can read public/unlisted files
      allow get: if isValidShareId(shareId) && (
        (isSignedIn() && existing().ownerId == request.auth.uid)
        || existing().visibility in ['public', 'unlisted']
      );

      // List queries: Strictly restricted to the authenticated owner's own files (no scraping)
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;

      // Create: Verified owner, full blueprint validation, server timestamps, valid owned folder if assigned
      allow create: if isVerifiedUser()
        && isValidShareId(shareId)
        && isValidUploadedFile(incoming(), shareId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && ownsFolderIfSet(incoming().folderId);

      // Action-Based Update: Validation blueprint first, immutable fields locked, strict affectedKeys allowlist
      allow update: if isVerifiedUser()
        && isValidShareId(shareId)
        && isValidUploadedFile(incoming(), shareId)
        && existing().ownerId == request.auth.uid
        && isImmutableFileUnchanged()
        && incoming().updatedAt == request.time
        && (
          // Action 1: Update access visibility
          incoming().diff(existing()).affectedKeys().hasOnly(['visibility', 'updatedAt'])
          // Action 2: Rename or edit description
          || incoming().diff(existing()).affectedKeys().hasOnly(['fileName', 'description', 'updatedAt'])
          // Action 3: Move to folder (verifies target folder ownership)
          || (
            incoming().diff(existing()).affectedKeys().hasOnly(['folderId', 'updatedAt'])
            && ownsFolderIfSet(incoming().folderId)
          )
          // Action 4: Combined metadata edit (fileName, description, visibility, folderId)
          || (
            incoming().diff(existing()).affectedKeys().hasOnly(['fileName', 'description', 'visibility', 'folderId', 'updatedAt'])
            && ownsFolderIfSet(incoming().folderId)
          )
        );

      // Delete: Verified owner only
      allow delete: if isVerifiedUser()
        && isValidShareId(shareId)
        && existing().ownerId == request.auth.uid;
    }
  }
}
